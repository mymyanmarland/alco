# ── ALCO environment ──────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit a real .env.

# PostgreSQL connection (Prisma).
# At deploy (M6) the VPS database `shweosdb` is created and this points at it,
# e.g. postgresql://shweos:***@127.0.0.1:5432/shweosdb
DATABASE_URL="postgresql://user:password@localhost:5432/shweosdb"

# better-auth: random 32+ char secret (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-random-secret"

# better-auth: public base URL of this app (used for reset links etc.)
BETTER_AUTH_URL="http://localhost:3000"

# ── AI provider (M3) — server-side only, never exposed to the client ──
# "mock" = canned replies for tests; anything else = OpenAI-compatible HTTP.
AI_PROVIDER="mock"
# Base URL of the /v1-compatible gateway (e.g. https://api.relaymodels.com/v1)
AI_BASE_URL="https://api.openai.com/v1"
# Server-wide gateway key — FALLBACK ONLY since BYO keys: each user brings
# their own key via Settings (/api/settings/api-key). Used only when the
# user has no stored key. Optional in production when all users use BYO.
AI_API_KEY=""
# ── BYO API key encryption ─────────────────────────────────────────────
# Master key for AES-256-GCM encryption of user-stored API keys
# (src/lib/apikey-crypto.ts). REQUIRED in production — the app fails closed
# without it. Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=""
# Default model id (for RelayModels use a bare model id, e.g. gemini-3.8-flash)
AI_DEFAULT_MODEL="gpt-4o-mini"
# Comma-separated model ids offered in the chat model selector (optional)
AI_MODELS=""
# Upstream request timeout in ms
AI_TIMEOUT_MS="60000"

# ── Builder storage (M4) — git repos per project live here ──
# Relative to the app working directory. Gitignored except .gitkeep.
STORAGE_DIR="storage"

# ── Sandbox execution (M5) ──
# "docker" = production Docker driver (node:22-slim, heavily restricted).
# "local"  = DEV/TEST ONLY driver (runs on the host — never for untrusted code).
SANDBOX_DRIVER="local"
# Static preview link TTL in ms (default 15 min, max 1 h). Lower for tests.
SANDBOX_PREVIEW_TTL_MS="900000"
# UID the docker driver chowns the workdir to (must be runnable by the app).
SANDBOX_RUN_UID="65532"
# Emergency escape hatch: allow the local (host) sandbox driver even when
# NODE_ENV=production. NEVER set this in production — the local driver runs
# untrusted code on the host. Default (unset) refuses in production.
# SANDBOX_ALLOW_LOCAL="0"

# ── Quotas & rate limits (M6-A) ──
# Max AI tokens (prompt+completion, estimated) per user per day.
AI_TOKENS_DAILY_CAP="200000"
# Max sandbox execution minutes per user per day (complements the M5
# in-code default of 10; the M5 default applies when this is unset).
SANDBOX_MINUTES_DAILY_CAP="10"
# API requests per minute per user (chat, builder, sandbox). Auth endpoints
# use AUTH_RATE_LIMIT_PER_MINUTE (per IP) for brute-force protection.
RATE_LIMIT_PER_MINUTE="60"
AUTH_RATE_LIMIT_PER_MINUTE="20"

# ── Admin (M6-A) ──
# Comma-separated emails allowed into /admin and /api/admin/overview.
# Non-listed users get 404. Leave empty = no admins.
ADMIN_EMAILS=""

# ── Prisma engine overrides (only needed where the Prisma CDN is blocked) ──
# This sandbox pre-seeded the engine cache via curl; on the VPS the normal
# Prisma engine download works and these can stay unset.
# PRISMA_SCHEMA_ENGINE_BINARY="/home/hatch/.cache/prisma/master/c2990dca591cba766e3b7ef5d9e8a84796e47ab7/debian-openssl-3.0.x/schema-engine"
# PRISMA_QUERY_ENGINE_LIBRARY="/home/hatch/.cache/prisma/master/c2990dca591cba766e3b7ef5d9e8a84796e47ab7/debian-openssl-3.0.x/libquery_engine.so.node"
